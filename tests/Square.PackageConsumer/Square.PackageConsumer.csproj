<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot Condition="'$(SquarePackageConsumerPublishAot)' == 'true'">true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <SquareEnableDefaultMarkup>true</SquareEnableDefaultMarkup>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Wuldas.Square" />
    <PackageReference Include="Wuldas.Square.Compiler" PrivateAssets="all" />
    <PackageReference Include="Wuldas.Square.Images" />
    <PackageReference Include="Wuldas.Square.Platform.Win32" Condition="'$(SquareTargetPlatform)' == 'Win32'" />
    <PackageReference Include="Wuldas.Square.Platform.X11" Condition="'$(SquareTargetPlatform)' == 'X11'" />
    <PackageReference Include="Wuldas.Square.Platform.MacOS" Condition="'$(SquareTargetPlatform)' == 'MacOS'" />
  </ItemGroup>
  <ItemGroup>
    <None Update="site.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
