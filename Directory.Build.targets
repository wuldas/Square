<Project>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)src\Square.Compiler\buildTransitive\Square.Compiler.targets" />

  <!-- Keep the selected runtime, ILCompiler, ILLink and apphost on the same patched version.
       Override the SDK's latest patch (which may be newer), but retain its default
       framework-dependent runtime baseline and targeting-pack version. -->
  <Target Name="PinPatchedNet10RuntimePacks" BeforeTargets="ProcessFrameworkReferences" Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <KnownFrameworkReference Update="Microsoft.NETCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net10.0'">
        <LatestRuntimeFrameworkVersion>10.0.14</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownRuntimePack Update="Microsoft.NETCore.App" Condition="'%(KnownRuntimePack.TargetFramework)' == 'net10.0'">
        <LatestRuntimeFrameworkVersion>10.0.14</LatestRuntimeFrameworkVersion>
      </KnownRuntimePack>
      <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" Condition="'%(KnownILCompilerPack.TargetFramework)' == 'net10.0'">
        <ILCompilerPackVersion>10.0.14</ILCompilerPackVersion>
      </KnownILCompilerPack>
      <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" Condition="'%(KnownILLinkPack.TargetFramework)' == 'net10.0'">
        <ILLinkPackVersion>10.0.14</ILLinkPackVersion>
      </KnownILLinkPack>
      <KnownAppHostPack Update="Microsoft.NETCore.App" Condition="'%(KnownAppHostPack.TargetFramework)' == 'net10.0'">
        <AppHostPackVersion>10.0.14</AppHostPackVersion>
      </KnownAppHostPack>
    </ItemGroup>
  </Target>

  <Target Name="ValidateSquareTargetPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SquareUnsupportedPlatform)' != ''" Text="$(SquareUnsupportedPlatform)" />
    <Error Condition="'$(SquareTargetPlatform)' != 'Win32' and '$(SquareTargetPlatform)' != 'X11' and '$(SquareTargetPlatform)' != 'MacOS' and '$(SquareTargetPlatform)' != 'Android'"
           Text="Unsupported SquareTargetPlatform '$(SquareTargetPlatform)'. Supported values are Win32, X11, MacOS, and Android." />
    <Error Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.Contains('linux')) and '$(SquareTargetPlatform)' != 'X11'"
           Text="RuntimeIdentifier '$(RuntimeIdentifier)' requires SquareTargetPlatform=X11." />
    <Error Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-')) and '$(SquareTargetPlatform)' != 'Win32'"
           Text="RuntimeIdentifier '$(RuntimeIdentifier)' requires SquareTargetPlatform=Win32." />
    <Error Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-')) and '$(SquareTargetPlatform)' != 'MacOS'"
           Text="RuntimeIdentifier '$(RuntimeIdentifier)' requires SquareTargetPlatform=MacOS." />
    <Error Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('android-')) and '$(SquareTargetPlatform)' != 'Android'"
           Text="RuntimeIdentifier '$(RuntimeIdentifier)' requires SquareTargetPlatform=Android." />
  </Target>

</Project>
