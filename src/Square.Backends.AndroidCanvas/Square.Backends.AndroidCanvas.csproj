<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <IsPackable>true</IsPackable>
    <Description>Square Android Canvas render backend</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SquareTargetPlatform>Android</SquareTargetPlatform>
    <DefineConstants>$(DefineConstants);PLATFORM_ANDROID;BACKEND_ANDROID_CANVAS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Square\Square.csproj">
      <AdditionalProperties>SquareTargetPlatform=Android</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views" />
  </ItemGroup>
</Project>