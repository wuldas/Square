<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Square Direct2D HWND render backend</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Square\Square.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DirectNAot" />
    <PackageReference Include="DirectNAot.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Square.Backends.Direct2D.Tests" />
    <InternalsVisibleTo Include="Square.Backends.Conformance.Tests" />
  </ItemGroup>

</Project>
