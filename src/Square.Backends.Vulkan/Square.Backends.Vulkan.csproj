<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(SquareTargetPlatform)' == 'Android'">net10.0-android</TargetFramework>
    <TargetFramework Condition="'$(SquareTargetPlatform)' != 'Android'">net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Square Vulkan GPU render backend (Silk.NET)</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Square\Square.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="LibTessDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Square.Backends.Vulkan.Tests" />
  </ItemGroup>

</Project>
