<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Square.Platform.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Square Win32 platform host</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="buildTransitive\**\*.cs" />
    <ProjectReference Include="..\Square\Square.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Square.Platform.Win32.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildTransitive\Square.Platform.Win32.Registration.cs" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
