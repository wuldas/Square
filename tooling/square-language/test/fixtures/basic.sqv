<template>
  <View class="page">
    <Button ref="SaveButton" @click.stop.prevent="OnSave">{{ Title }}</Button>
    <Text v-if="Visible">Ready</Text>
    <Text v-else>Fallback</Text>
    <Text v-for="(item, index) in Items" :key="item.Id">
      {{ index }} {{ item.Name }}
    </Text>
    <Card><template #header="{ title }">{{ title }}</template></Card>
    <SlotCard>
      <template v-slot:header>
        <Text class="slot-fallback" text="Fallback" />
      </template>
    </SlotCard>
    <Slot name="header">
      <Text class="slot-fallback" text="Fallback" />
    </Slot>
  </View>
</template>

<script lang="csharp">
  private string Title => "Square";
</script>

<style>
  .page { display: flex; gap: 8px; }
</style>
