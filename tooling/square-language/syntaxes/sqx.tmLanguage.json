{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Square SQX",
  "scopeName": "source.sqx",
  "fileTypes": ["sqx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#template-section" },
    { "include": "#script-section" },
    { "include": "#style-section" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sqx",
          "begin": "<!--",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.sqx" } },
          "end": "-->",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.sqx" } }
        }
      ]
    },
    "template-section": {
      "name": "meta.section.template.sqx",
      "begin": "^([ \\t]*)(<)(template)(?=[\\s>])",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.tag.begin.sqx" },
        "3": { "name": "entity.name.tag.section.sqx" }
      },
      "end": "(</)(template)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.sqx" },
        "2": { "name": "entity.name.tag.section.sqx" },
        "3": { "name": "punctuation.definition.tag.end.sqx" }
      },
      "patterns": [
        { "include": "#template" }
      ]
    },
    "script-section": {
      "name": "meta.section.script.sqx",
      "begin": "^([ \\t]*)(<)(script)(?=[\\s>])",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.tag.begin.sqx" },
        "3": { "name": "entity.name.tag.section.sqx" }
      },
      "end": "(</)(script)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.sqx" },
        "2": { "name": "entity.name.tag.section.sqx" },
        "3": { "name": "punctuation.definition.tag.end.sqx" }
      },
      "patterns": [
        { "include": "#section-attributes" },
        {
          "begin": ">",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.end.sqx" } },
          "end": "(?=</script)",
          "contentName": "source.cs",
          "patterns": [
            { "include": "source.cs" }
          ]
        }
      ]
    },
    "style-section": {
      "name": "meta.section.style.sqx",
      "begin": "^([ \\t]*)(<)(style)(?=[\\s>])",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.tag.begin.sqx" },
        "3": { "name": "entity.name.tag.section.sqx" }
      },
      "end": "(</)(style)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.sqx" },
        "2": { "name": "entity.name.tag.section.sqx" },
        "3": { "name": "punctuation.definition.tag.end.sqx" }
      },
      "patterns": [
        { "include": "#section-attributes" },
        {
          "begin": ">",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.end.sqx" } },
          "end": "(?=</style)",
          "contentName": "source.css",
          "patterns": [
            { "include": "source.css" }
          ]
        }
      ]
    },
    "section-attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.sqx",
          "match": "\\b(?:lang|namespace|name|access)\\b"
        },
        { "include": "#quoted-string" }
      ]
    },
    "template": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#closing-tag" },
        { "include": "#directive-tag" },
        { "include": "#opening-tag" },
        { "include": "#csharp-expression" },
        {
          "name": "punctuation.definition.fragment.sqx",
          "match": "</?>"
        }
      ]
    },
    "directive-tag": {
      "name": "meta.tag.directive.sqx",
      "begin": "(<)(Show|For|Index|Switch|Match|Slot|Outlet)(?=[\\s/>])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.sqx" },
        "2": { "name": "entity.name.tag.directive.sqx" }
      },
      "end": "(/?>)|$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.sqx" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "entity.other.attribute-name.directive.sqx",
          "match": "\\b(?:when|each|fallback|name|ref|slot)\\b"
        },
        {
          "name": "entity.other.attribute-name.event.sqx",
          "match": "\\bon[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.other.attribute-name.sqx",
          "match": "\\b[A-Za-z_:][A-Za-z0-9_.:-]*\\b"
        },
        {
          "name": "keyword.operator.assignment.sqx",
          "match": "="
        },
        { "include": "#csharp-expression" },
        { "include": "#quoted-string" }
      ]
    },
    "closing-tag": {
      "name": "meta.tag.sqx",
      "match": "(</)(?!(?:template|script|style)\\b)([A-Za-z_][A-Za-z0-9_.:-]*)(\\s*>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.sqx" },
        "2": { "name": "entity.name.tag.sqx" },
        "3": { "name": "punctuation.definition.tag.end.sqx" }
      }
    },
    "opening-tag": {
      "name": "meta.tag.sqx",
      "begin": "(<)([A-Za-z_][A-Za-z0-9_.:-]*)(?=[\\s/>])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.sqx" },
        "2": { "name": "entity.name.tag.sqx" }
      },
      "end": "(/?>)|$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.sqx" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "entity.other.attribute-name.event.sqx",
          "match": "\\bon[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.other.attribute-name.directive.sqx",
          "match": "\\b(?:ref|slot|when|each|fallback)\\b"
        },
        {
          "name": "entity.other.attribute-name.sqx",
          "match": "\\b[A-Za-z_:][A-Za-z0-9_.:-]*\\b"
        },
        {
          "name": "keyword.operator.assignment.sqx",
          "match": "="
        },
        { "include": "#csharp-expression" },
        { "include": "#quoted-string" }
      ]
    },
    "quoted-string": {
      "name": "string.quoted.double.sqx",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.sqx" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.sqx" } },
      "patterns": [
        {
          "name": "constant.character.entity.sqx",
          "match": "&(?:[A-Za-z][A-Za-z0-9]+|#[0-9]+|#x[0-9A-Fa-f]+);"
        }
      ]
    },
    "csharp-expression": {
      "name": "meta.embedded.expression.cs.sqx",
      "contentName": "source.cs",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.sqx" } },
      "end": "\\}|$",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.sqx" } },
      "patterns": [
        { "include": "source.cs" }
      ]
    }
  }
}
