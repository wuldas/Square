{
  "name": "square-language-support",
  "displayName": "Square Language Support",
  "description": "Syntax highlighting and editing support for Square SQX and SQV components.",
  "version": "0.3.0",
  "publisher": "wuldas",
  "license": "MIT",
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuldas/Square.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["square", "sqx", "sqv", "csharp", "ui"],
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run sync-assets && npm run build && npm run build-server && node ../square-language/test/verify-vscode-package.mjs",
    "build-server": "node scripts/build-server.mjs",
    "package": "npm run test && vsce package --out ../../artifacts/square-language-support.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "activationEvents": ["onLanguage:sqx", "onLanguage:sqv"],
  "contributes": {
    "configuration": {
      "title": "Square Language Support",
      "properties": {
        "square.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Executable used to start Square Language Server. Leave empty to use the bundled server or the workspace development fallback."
        },
        "square.languageServer.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the configured Square Language Server executable."
        },
        "square.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Square semantic diagnostics and language-server features."
        }
      }
    },
    "languages": [
      {
        "id": "sqx",
        "aliases": ["Square SQX", "SQX"],
        "extensions": [".sqx"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/square-file.svg",
          "dark": "./icons/square-file.svg"
        }
      },
      {
        "id": "sqv",
        "aliases": ["Square SQV", "SQV"],
        "extensions": [".sqv"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/square-file.svg",
          "dark": "./icons/square-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sqx",
        "scopeName": "source.sqx",
        "path": "./syntaxes/sqx.tmLanguage.json",
        "embeddedLanguages": {
          "source.cs": "csharp",
          "source.css": "css"
        }
      },
      {
        "language": "sqv",
        "scopeName": "source.sqv",
        "path": "./syntaxes/sqv.tmLanguage.json",
        "embeddedLanguages": {
          "source.cs": "csharp",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "sqx",
        "path": "./snippets/square.json"
      },
      {
        "language": "sqv",
        "path": "./snippets/square.json"
      }
    ]
  }
}
