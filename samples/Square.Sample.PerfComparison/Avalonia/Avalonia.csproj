<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Console subsystem so the benchmark result line is printable to stdout. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Square.Sample.PerfComparison.Avalonia</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are centrally managed (Directory.Packages.props):
         parent adds Avalonia / Avalonia.Desktop / Avalonia.Themes.Fluent @ 11.3.12. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
