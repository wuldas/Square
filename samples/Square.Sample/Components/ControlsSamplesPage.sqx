<template>
  <View class="controls-page sample-page">
    <Text class="page-title" text="Controls and reactive collections" />
    <Button ref={MyBtn} onClick={OnClick}>Button - add activity</Button>
    <CheckBox ref={AcceptCheckBox} text="CheckBox - enable feature" checked={Accepted} onChange={OnAcceptedChanged} />
    <Radio ref={RadioA} text="Radio - option A" group="demo" checked={OptionA} onChange={OnRadioAChanged} />
    <Radio ref={RadioB} text="Radio - option B" group="demo" checked={OptionB} onChange={OnRadioBChanged} />
    <Select ref={DemoSelect} value={SelectedValue} options={ColorOptions} onChange={OnSelectChanged} />
    <List ref={DemoList} items={ListOptions} onChange={OnListChanged} style="height: 96px; border: 1px solid #c7cdd4;" />
    <Text class="status" text={ListSelectionStatus} />
    <Tree ref={DemoTree} onChange={OnTreeChanged} style="height: 160px; border: 1px solid #c7cdd4;">
      <TreeItem text="Tree - workspace" expanded="true">
        <TreeItem text="src">
          <TreeItem text="Square" />
          <TreeItem text="Square.Compiler" />
        </TreeItem>
        <TreeItem text="tests" />
      </TreeItem>
      <TreeItem text="Tree - README.md" />
    </Tree>
    <Text class="status" text={TreeSelectionStatus} />
    <View style="display: flex; flex-direction: row; gap: 8px;">
      <Button onClick={OnPreviousSlide}>Previous slide</Button>
      <Button onClick={OnNextSlide}>Next slide</Button>
    </View>
    <Swiper ref={DemoSwiper} loop="true" onChange={OnSlideChanged} style="height: 84px; border: 1px solid #c7cdd4;">
      <View style="padding: 12px; background: #eff6ff;"><Text>Swiper - first page</Text></View>
      <View style="padding: 12px; background: #ecfdf3;"><Text>Swiper - second page</Text></View>
      <View style="padding: 12px; background: #fff7ed;"><Text>Swiper - third page</Text></View>
    </Swiper>
    <Text class="status" text={SwiperStatus} />
    <Show when={ShowCount}>
      <Text class="status" text="Show: button clicked" />
    </Show>
    <For each={Items}>{(it)=>
      <Text class="status" text={it} />
    }</For>
  </View>
</template>
<script lang="csharp">
  private int _count;
  public ObservableValue<bool> ShowCount = new(false);
  public ObservableValue<bool> LastEventSourceWasButton = new(false);
  public ObservableValue<bool> Accepted = new(false);
  public ObservableValue<bool> OptionA = new(true);
  public ObservableValue<bool> OptionB = new(false);
  public ObservableValue<string> SelectedValue = new("Blue");
  public ObservableValue<string[]> ColorOptions = new(["Blue", "Green", "Orange"]);
  public ObservableValue<string[]> ListOptions = new(["List - first", "List - second", "List - third"]);
  public ObservableValue<string> ListSelectionStatus = new("List: no selection");
  public ObservableValue<string> TreeSelectionStatus = new("Tree: no selection");
  public ObservableValue<string> SwiperStatus = new("Swiper: page 1");
  public ObservableCollection<string> Items = new() { "For: ready" };

  private void OnClick(Event e)
  {
    LastEventSourceWasButton.Value = e.CurrentTarget == MyBtn && e.Target == MyBtn;
    _count++;
    ShowCount.Value = true;
    Items.Add("Click " + _count);
    System.Console.WriteLine($"Square.Sample activity {_count}");
  }

  private void OnAcceptedChanged(Event e)
  {
    Accepted.Value = AcceptCheckBox.IsChecked;
  }

  private void OnRadioAChanged()
  {
    OptionA.Value = true;
    OptionB.Value = false;
  }

  private void OnRadioBChanged()
  {
    OptionA.Value = false;
    OptionB.Value = true;
  }

  private void OnSelectChanged()
  {
    SelectedValue.Value = DemoSelect.Value;
  }

  private void OnListChanged()
  {
    ListSelectionStatus.Value = DemoList.SelectedItem is null
      ? "List: no selection"
      : "List: " + DemoList.SelectedItem.TextContent;
  }

  private void OnTreeChanged()
  {
    TreeSelectionStatus.Value = DemoTree.SelectedItem is null
      ? "Tree: no selection"
      : "Tree: " + DemoTree.SelectedItem.TextContent;
  }

  private void OnPreviousSlide() => DemoSwiper.Previous();
  private void OnNextSlide() => DemoSwiper.Next();

  private void OnSlideChanged()
  {
    SwiperStatus.Value = "Swiper: page " + (DemoSwiper.SelectedIndex + 1);
  }
</script>
<style>
  .sample-page { display: flex; flex-direction: column; gap: 10px; padding: 0; overflow-y: auto; }
  .page-title { color: #202124; font-size: 18px; }
  .status { color: #555b61; font-size: 14px; }
  .controls-page Button { background: #0078d4; color: #ffffff; }
</style>
