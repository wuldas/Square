<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanvasBenchmark.V11.Avalonia</AssemblyName>
    <RootNamespace>CanvasBenchmark.V11</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The pinned 11.3.12 stream font loader is an unstable public implementation API. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);AVA3001</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
</Project>
