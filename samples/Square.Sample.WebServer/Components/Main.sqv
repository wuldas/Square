  .window-close-button { font-size: 22px; }

  .app-shell { display: flex; flex-direction: column; width: 100%; min-width: 0; min-height: 0; flex-grow: 1; background: #f4f6f8; color: #212529; font-size: 15px; overflow: hidden; }
  .app-toolbar { display: flex; flex-direction: row; align-items: center; height: 48px; min-height: 48px; padding: 0 14px; background: #ffffff; border-bottom: 1px solid #e5e7eb; box-shadow: 0 1px 8px rgba(15,23,42,0.06); }
  .toolbar-left, .toolbar-right { display: flex; flex-direction: row; align-items: center; gap: 4px; flex-grow: 1; flex-basis: 0; min-width: 0; }
  .toolbar-right { justify-content: flex-end; }
  .toolbar-icon-button, .small-icon-button, .rail-icon-button, .composer-icon-button { display: flex; align-items: center; justify-content: center; border: 0; background: #ffffff; color: #495057; }
