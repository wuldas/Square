  .workbench-row { display: flex; flex-direction: row; min-width: 0; min-height: 0; flex-grow: 1; align-items: stretch; overflow: hidden; }
  .pane-divider { width: 1px; min-width: 1px; height: 100%; background: #e5e7eb; }
  .workspace-rail { display: flex; flex-direction: column; justify-content: space-between; width: 72px; min-width: 72px; padding: 16px 0; background: #f8fafc; border-right: 1px solid #e5e7eb; }
