      <View class="workbench-row">
        <View class="workspace-rail">
          <View class="workspace-list">
            <Button class="workspace-button workspace-active" text="P" />
            <Button class="workspace-button workspace-cyan" text="S" />
            <Button class="workspace-button workspace-amber" text="B" />
            <Button class="workspace-add-button" text="+" />
          </View>
