  .toolbar-text-button { height: 32px; padding: 0 10px; border: 0; background: #ffffff; color: #495057; border-radius: 6px; font-size: 12px; }
  .connection-pill { display: flex; flex-direction: row; align-items: center; gap: 7px; height: 32px; padding: 0 9px; }
