          <Button class="session-filter" text="All time  ▾" />

          <ScrollViewer class="session-list-scroll">
            <View class="session-list">
              <Button ref="SessionOne" class="session-item session-item-active">
                <View class="session-icon-box"><Text class="session-icon-text" text="✦" /></View>
                <View class="session-copy">
                  <Text class="session-title" text="Build the PiSquared workbench" />
                  <Text class="session-meta" text="8 messages · just now" />
                </View>
              </Button>
              <Button ref="SessionTwo" class="session-item">
                <View class="session-icon-box"><Text class="session-icon-text" text="✦" /></View>
                <View class="session-copy">
                  <Text class="session-title" text="Design the approval flow" />
