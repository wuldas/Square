              <Button ref="SessionThree" class="session-item">
                <View class="session-icon-box"><Text class="session-icon-text" text="✦" /></View>
                <View class="session-copy">
                  <Text class="session-title" text="SQLite session architecture" />
                  <Text class="session-meta" text="21 messages · yesterday" />
                </View>
              </Button>
              <Button ref="SessionFour" class="session-item">
                <View class="session-icon-box"><Text class="session-icon-text" text="✦" /></View>
                <View class="session-copy">
                  <Text class="session-title" text="Provider protocol research" />
                  <Text class="session-meta" text="11 messages · Jul 28" />
                </View>
              </Button>
              <Button ref="SessionFive" class="session-item">
                <View class="session-icon-box"><Text class="session-icon-text" text="✦" /></View>
                <View class="session-copy">
                  <Text class="session-title" text="Workspace safety rules" />
                  <Text class="session-meta" text="6 messages · Jul 27" />
                </View>
              </Button>
            </View>
          </ScrollViewer>
          <Text class="session-count" :text="SessionCount" />
        </View>

        <View class="pane-divider" />

        <View class="conversation-panel">
          <View class="conversation-header">
            <View class="conversation-heading-copy">
              <Text class="conversation-title" text="Build the PiSquared workbench" />
              <Text class="conversation-subtitle" text="UI prototype · local workspace" />
            </View>
            <View class="conversation-header-actions">
              <Button class="header-chip" text="Run mock stream" />
              <Button class="header-chip" text="Default" />
              <Button class="small-icon-button" text="•••" />
            </View>
          </View>

          <ScrollViewer class="conversation-scroll">
            <View class="conversation-document">
              <View class="welcome-card">
                <View class="welcome-icon"><Text class="welcome-icon-text" text="✦" /></View>
                <View class="welcome-copy">
                  <Text class="welcome-title" text="A focused coding workspace" />
                  <Text class="welcome-body" text="Investigation, tools, changes and review share one quiet desktop surface." />
                  <View class="welcome-tags">
                    <View class="welcome-tag"><Text text="Square UI" /></View>
                    <View class="welcome-tag"><Text text="Diff approval" /></View>
                    <View class="welcome-tag"><Text text="Local sessions" /></View>
                  </View>
                </View>
              </View>

              <View class="message-block user-message">
                <Text class="message-body" text="先做 UI，参考 bomp 的工作区轨道、会话栏和右侧上下文。" />
              </View>

              <View class="message-block assistant-message">
                <View class="message-meta">
                  <View class="assistant-avatar"><Text class="assistant-avatar-text" text="P²" /></View>
                  <Text class="message-author" text="PiSquared" />
                  <Text class="message-model" text="UI design preview" />
                </View>
                <Text class="assistant-paragraph" text="先建立可运行的静态工作台，验证布局、滚动和交互状态。" />
                <View class="design-summary">
                  <Text class="design-summary-title" text="UI direction" />
                  <Text class="design-summary-line" text="• 64px workspace rail for project switching" />
                  <Text class="design-summary-line" text="• compact, searchable session history" />
                  <Text class="design-summary-line" text="• document-style transcript" />
                  <Text class="design-summary-line" text="• persistent Changes and Files context" />
                </View>
              </View>

              <View class="tool-card">
                <View class="tool-card-header">
                  <View class="tool-card-title-group">
                    <View class="tool-status-icon"><Text class="tool-status-glyph" text="✓" /></View>
                    <View class="tool-card-copy">
                      <Text class="tool-card-title" text="inspect_workspace" />
                      <Text class="tool-card-summary" text="Read BOMP layout and Square component samples" />
                    </View>
                  </View>
                  <View class="tool-card-state"><Text class="tool-duration" text="1.4s" /><Text class="tool-chevron" text="⌄" /></View>
                </View>
              </View>

              <View class="message-block assistant-message preview-message">
                <View class="message-meta">
                  <View class="assistant-avatar"><Text class="assistant-avatar-text" text="P²" /></View>
                  <Text class="message-author" text="PiSquared" />
                  <Text class="message-model" text="UI design preview" />
                </View>
                <Text class="assistant-paragraph" text="The preview uses quiet surfaces and reserves blue for focus and selection." />
                <View class="conversation-notice">
                  <Text class="notice-title" text="Preview scope" />
                  <Text class="notice-body" text="Buttons update mock state only. Runtime services come after layout validation." />
                </View>
              </View>

              <View v-for="message in SentMessages" class="message-block user-message">
                <Text class="message-body" :text="message" />
              </View>
            </View>
          </ScrollViewer>

          <View class="composer-shell">
            <View class="composer-box">
              <TextArea id="composer-input" class="composer-input" placeholder="Ask PiSquared to inspect or change this workspace..." v-model="ComposerText" />
              <View class="composer-actions">
                <View class="composer-left-actions">
                  <Button class="composer-icon-button" text="＋" />
                  <Text class="composer-hint" text="Enter to send · Shift+Enter for a new line" />
                </View>
                <Button class="send-button" text="➤" @click="SendMessage" />
              </View>
            </View>
            <View class="composer-footer">
              <Button class="footer-control" text="Build  ▾" />
              <Button class="footer-control" text="Claude Sonnet 4  ▾" />
              <Button class="footer-control" text="Thinking: Medium  ▾" />
              <View class="composer-footer-spacer" />
              <Text class="context-usage" text="Context 18%" />
            </View>
          </View>
        </View>

        <View class="pane-divider" />

        <View class="context-sidebar">
          <View class="context-tabs">
            <Button :class="ChangesTabClass" text="Changes" @click="ShowChangesPanel" />
            <Button :class="FilesTabClass" text="Files" @click="ShowFilesPanel" />
          </View>
          <View v-if="ShowChanges" class="context-content">
            <View class="context-heading">
              <View class="context-heading-copy"><Text class="context-heading-icon" text="⑂" /><Text class="context-heading-title" text="main" /></View>
              <Button class="small-icon-button" text="↻" />
            </View>
            <Text class="context-section-label" text="WORKING CHANGES" />
            <Button class="change-row change-row-active">
              <Text class="change-status modified" text="M" />
              <View class="change-copy"><Text class="change-path" text="src/PiSquared.App/Components/Workbench.sqx" /><Text class="change-lines" text="+318  -0" /></View>
            </Button>
            <Button class="change-row">
              <Text class="change-status added" text="A" />
              <View class="change-copy"><Text class="change-path" text="src/PiSquared.App/Program.cs" /><Text class="change-lines" text="+24  -0" /></View>
            </Button>
            <Button class="change-row">
              <Text class="change-status added" text="A" />
              <View class="change-copy"><Text class="change-path" text="Directory.Build.props" /><Text class="change-lines" text="+10  -0" /></View>
            </Button>
            <View class="change-summary-card">
              <Text class="change-summary-kicker" text="PROPOSED REVIEW" />
              <Text class="change-summary-title" text="3 files changed" />
              <Text class="change-summary-body" text="Desktop shell and mock interactions are ready for review." />
              <View class="change-summary-actions">
                <Button class="secondary-action" text="Review diff" />
                <Button class="primary-action" :text="AcceptText" @click="AcceptChanges" />
              </View>
            </View>
          </View>
          <View v-if="ShowFiles" class="context-content">
            <View class="context-heading">
              <View class="context-heading-copy"><Text class="context-heading-icon" text="▤" /><Text class="context-heading-title" text="Workspace files" /></View>
            </View>
            <Text class="context-section-label" text="OPEN FILES" />
            <View class="file-row"><Text class="change-path" text="Components/Main.sqv" /></View>
            <View class="file-row"><Text class="change-path" text="Program.cs" /></View>
            <View class="file-row"><Text class="change-path" text="Square.Sample.WebServer.csproj" /></View>
          </View>
        </View>
      </View>

      <View class="status-bar">
        <View class="status-left"><Text class="status-brand" text="PiSquared" /><Text class="status-copy" :text="StatusText" /></View>
        <View class="status-right"><Text class="status-copy" text="main" /><Text class="status-copy" text="3 changes" /><Text class="status-copy" text="Software renderer" /></View>
      </View>
    </View>
  </View>
</template>

<script lang="csharp">
  public ObservableValue<string> SessionSearch = new("");
  public ObservableValue<string> SessionCount = new("5 sessions in this workspace");
  public ObservableValue<string> ComposerText = new("");
  public ObservableCollection<string> SentMessages = new();
  public ObservableValue<bool> ShowChanges = new(true);
  public ObservableValue<bool> ShowFiles = new(false);
  public ObservableValue<string> ChangesTabClass = new("context-tab context-tab-active");
  public ObservableValue<string> FilesTabClass = new("context-tab");
  public ObservableValue<string> AcceptText = new("Accept");
  public ObservableValue<string> StatusText = new("Interactive preview ready");

  private void OnSessionSearch(Event e)
  {
    var query = ((Input)e.Target!).Value.Trim();
    var visible = 0;
    visible += SetSessionVisibility(SessionOne, "Build the PiSquared workbench", query);
    visible += SetSessionVisibility(SessionTwo, "Design the approval flow", query);
    visible += SetSessionVisibility(SessionThree, "SQLite session architecture", query);
    visible += SetSessionVisibility(SessionFour, "Provider protocol research", query);
    visible += SetSessionVisibility(SessionFive, "Workspace safety rules", query);
    SessionCount.Value = visible + (visible == 1 ? " session" : " sessions") + " in this workspace";
  }

  private static int SetSessionVisibility(Button session, string title, string query)
  {
    session.IsVisible = query.Length == 0 || title.Contains(query, StringComparison.OrdinalIgnoreCase);
    return session.IsVisible ? 1 : 0;
  }

  private void ShowChangesPanel()
  {
    ShowChanges.Value = true;
    ShowFiles.Value = false;
    ChangesTabClass.Value = "context-tab context-tab-active";
    FilesTabClass.Value = "context-tab";
    StatusText.Value = "Reviewing working changes";
  }

  private void ShowFilesPanel()
  {
    ShowChanges.Value = false;
    ShowFiles.Value = true;
    ChangesTabClass.Value = "context-tab";
    FilesTabClass.Value = "context-tab context-tab-active";
    StatusText.Value = "Browsing workspace files";
  }

  private void SendMessage()
  {
    var message = ComposerText.Value.Trim();
    if (message.Length == 0) return;
    SentMessages.Add(message);
    ComposerText.Value = "";
    StatusText.Value = "Message added to the local session";
  }

  private void AcceptChanges()
  {
    AcceptText.Value = "Accepted";
    StatusText.Value = "3 changes accepted for review";
  }
</script>

<style>
  .window-shell { display: flex; flex-direction: column; width: 100%; height: 100vh; min-width: 1180px; min-height: 720px; overflow: hidden; background: #f4f6f8; font-family: "Segoe UI", Arial, sans-serif; }
