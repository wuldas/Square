  .command-search { display: flex; flex-direction: row; align-items: center; gap: 10px; width: 500px; height: 36px; padding: 0 14px; background: #f8fafc; border: 1px solid #d9e2ec; border-radius: 10px; color: #64748b; }
  .command-search-icon { color: #6c757d; font-size: 22px; }
