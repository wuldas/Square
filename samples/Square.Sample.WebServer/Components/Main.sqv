          <Button class="new-session-button"><Text class="new-session-icon" text="＋" /><Text text="New session" /></Button>
          <Text class="section-label" text="RECENT SESSIONS" />

          <View class="session-search-box">
            <Text class="session-search-icon" text="⌕" />
            <Input id="session-search" class="session-search-input" placeholder="Search sessions" v-model="SessionSearch" @input="OnSessionSearch" />
