<template>
  <View class="page">
    <Text class="title" text="Square Android" />
    <Text class="description" text="Software renderer / Canvas-first platform host" />
    <Button class="action" @click="OnTap">Tap the button</Button>
    <Button class="wrapped-action" @click="OnTap">Tap this button to check that wrapped text increases its height</Button>
    <Text class="status" :text="Status" />
    <Input class="input" placeholder="Tap to open the keyboard" />
    <ScrollViewer class="scroll">
      <View class="scroll-content">
        <Text class="scroll-title" text="Touch scrolling" />
        <Text class="scroll-copy" text="Swipe this area to scroll. The Android host translates touch motion into Square wheel input and keeps the click target from firing after a drag." />
        <Text class="scroll-copy" text="The same retained Element Tree, CSS layout and Software RenderContext are used on desktop and Android." />
        <Text class="scroll-copy" text="Line 1" />
