        <Text class="scroll-copy" text="Line 10" />
      </View>
    </ScrollViewer>
  </View>
</template>
<script lang="csharp">
  public ObservableValue<string> Status = new("Ready");

  private void OnTap()
  {
    Status.Value = "Tapped";
  }
</script>
