<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageType>Template</PackageType>
    <Description>Square application and component templates for dotnet new</Description>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TemplateContentRoot Condition="'$(TemplateContentRoot)' == ''">$(MSBuildProjectDirectory)\content</TemplateContentRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(TemplateContentRoot)\**\*"
             Exclude="$(TemplateContentRoot)\**\bin\**;$(TemplateContentRoot)\**\obj\**"
             PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
