<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Square" Version="0.1.0" />
    <PackageVersion Include="Square.Compiler" Version="0.1.0" />
    <PackageVersion Include="Square.Images" Version="0.1.0" />
    <PackageVersion Include="Square.Platform.Win32" Version="0.1.0" />
    <PackageVersion Include="Square.Platform.X11" Version="0.1.0" />
    <PackageVersion Include="Square.Platform.MacOS" Version="0.1.0" />
    <PackageVersion Include="Square.Native.Html" Version="0.1.0" />
    <PackageVersion Include="Square.Hosting.Web" Version="0.1.0" />
    <PackageVersion Include="WebView2Aot" Version="1.5.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageVersion Include="DirectNAot" Version="1.6.1" />
    <PackageVersion Include="DirectNAot.Extensions" Version="1.6.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.14.2094" />
    <PackageVersion Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" />
    <PackageVersion Include="Microsoft.VisualStudio.CoreUtility" Version="17.14.249" />
    <PackageVersion Include="Microsoft.VisualStudio.Text.Logic" Version="17.14.249" />
    <PackageVersion Include="Microsoft.VisualStudio.Utilities" Version="17.13.40008" />
    <PackageVersion Include="Microsoft.VisualStudio.Telemetry" Version="17.14.2" />
    <PackageVersion Include="Silk.NET.Shaderc" Version="2.22.0" />
    <PackageVersion Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- Meta Yoga 纯 C# 移植（Flexbox；AOT/NativeAOT） -->
    <PackageVersion Include="Yoga.Net" Version="3.2.3" />
    <!-- Vulkan 后端 -->
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="LibTessDotNet" Version="1.1.15" />
    <!-- Skia CPU 后端 -->
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.Views" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
  </ItemGroup>
</Project>
